{
    "configurations": [
        {
            "name": "Linux",
            "configurationProvider": "ms-vscode.cmake-tools",
            "compileCommands": [
                "${workspaceFolder}/build/compile_commands.json"
            ],
            "cppStandard": "c++17",
            "intelliSenseMode": "${default}",
            "includePath": [
                "../Qt/5.15.2/gcc_64/include"
            ],
            "compilerPath": "/usr/bin/gcc"
        }
    ],
    "version": 4
}

